<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="nz.gobeyond.tv">
    <!-- versionCode and versionName come from build.sh (CI numbers each release). -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- After the TV boots (and after a TV update), checks that Beyond TV mode is still as you left it. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Updates: Android still shows its own install prompt, and the TV asks once to allow Beyond TV to install apps. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Beyond Family (once the TV is linked): waits for the phone remote and the family's messages while another
         app has the screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- A Beyond Family message over YouTube or any other app (Android 10 and up), allowed through the TV's own ADB. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+: without this list the app can't "see" the other apps (getLeanbackLaunchIntentForPackage
         returns null). The shelf and streaming apps, the live TV apps and, through the <intent>, every TV app
         (for "All Apps"). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.hbo.hbonow" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.apple.atve.sony.appletv" />
        <package android:name="com.hulu.livingroomplus" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.globo.globotv" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.tcl.tv" />
        <package android:name="com.google.android.tv" />
        <package android:name="com.mediatek.wwtv.tvcenter" />
        <package android:name="com.sony.dtv.tvx" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".App"
        android:label="Beyond™ TV"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- The app's icon opens the settings (switch between Beyond TV and the original home screen). -->
        <activity
            android:name=".SettingsActivity"
            android:process=":home"
            android:exported="true"
            android:label="Beyond™ TV"
            android:launchMode="singleTask"
            android:taskAffinity="nz.gobeyond.tv.settings"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home screen. Its own process (:home): if it ever crashes, the safety net in the main process still
             works. It only becomes the TV's home screen in Beyond TV mode (cmd package set-home-activity). -->
        <activity
            android:name=".HomeActivity"
            android:process=":home"
            android:exported="true"
            android:label="Beyond™ TV"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".Screensaver"
            android:process=":home"
            android:enabled="@bool/dream_in_home"
            android:exported="true"
            android:label="Beyond™ TV"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The same screensaver on Android 11, in the main process (see ScreensaverAlone). -->
        <service
            android:name=".ScreensaverAlone"
            android:enabled="@bool/dream_alone"
            android:exported="true"
            android:label="Beyond™ TV"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The switches, as background jobs in the main process. -->
        <service
            android:name=".ModeJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- The remote's app buttons from inside any app (Settings > Remote Buttons). Its own process: the system waits for it on
             every key, so the home screen must never be able to slow it down. -->
        <service
            android:name=".RemoteKeyService"
            android:process=":keys"
            android:exported="true"
            android:label="Beyond™ TV"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/remote_key_service" />
        </service>

        <!-- Talk to Beyond: feedback from the home screen's four-dots button. -->
        <activity
            android:name=".FeedbackActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- The screensaver over the home screen after a few quiet minutes (Settings: Screensaver after). -->
        <activity
            android:name=".SaverActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Party mode: lights and music for a disco or a birthday. -->
        <activity
            android:name=".PartyActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Tonight's sky: a star chart for where the TV is, and the moon. -->
        <activity
            android:name=".SkyActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Games from the remote: karaoke, party, quiz night, the dinner question, the tidy race, bedtime. -->
        <activity
            android:name=".GamesActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Board and card games against the robots: the web games in a WebView (ADR 0024). -->
        <activity
            android:name=".TableActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Ask Beyond and the notes from Beyond Family: the web app's orb and notes in a WebView (ADR 0025). -->
        <activity
            android:name=".AskActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Karaoke from the remote: who's singing, then the song. -->
        <activity
            android:name=".KaraokePickActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Party mode from the remote: a disco or somebody's birthday. -->
        <activity
            android:name=".PartyPickActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- A message from Beyond Family, full screen until somebody presses OK. -->
        <activity
            android:name=".SayActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- The family's own music: Beyond Music's TV screens, full screen (ADR 0027). -->
        <activity
            android:name=".MusicActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Karaoke night: who's up, then the song's karaoke version on YouTube. -->
        <activity
            android:name=".KaraokeActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Bedtime breathing: a night light that breathes, then fades to dark. -->
        <activity
            android:name=".BedtimeActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Earn your screen: a kid's jobs for today, in place of the app, until they're ticked off. -->
        <activity
            android:name=".JobsActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- The tidy-up race: a big clock, everyone's face, OK on yours when you're done. -->
        <activity
            android:name=".TidyActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- The dinner question: everyone answers on their phones, then the answers come up together. -->
        <activity
            android:name=".DinnerActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Quiz night: ten questions, everyone buzzes in on their phones, then the scores. -->
        <activity
            android:name=".QuizActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Your home: a room from the Beyond Home box, or the code that connects it. -->
        <activity
            android:name=".RoomActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- A camera tile from Beyond Family, full screen: a fresh picture every two seconds. -->
        <activity
            android:name=".CameraActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Make it yours: a kid picks their buddy, colour, world and the things they love. -->
        <activity
            android:name=".MyWorldActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Who's watching? Family first, then each person; also where people and the grown-up PIN are set. -->
        <activity
            android:name=".WhoActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Beyond Family: link this TV with a code, or unlink it (Settings > Beyond Family). -->
        <activity
            android:name=".LinkActivity"
            android:process=":home"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/BeyondTV.Home" />

        <!-- Beyond Family: the long wait for the phone remote and messages, only while the TV is linked. In :home,
             with the people it fills in. -->
        <service
            android:name=".FamilyService"
            android:process=":home"
            android:exported="false" />

        <!-- The installer's answer to an update (Updater): shows Android's own install prompt. -->
        <receiver
            android:name=".Updater$Result"
            android:process=":home"
            android:exported="false" />

        <!-- The sleep timer: a minute's warning, then the TV turns off (Sleep). -->
        <receiver
            android:name=".Sleep$Receiver"
            android:exported="false" />

        <!-- The tidy-up race's nightly alarm (Tidy): turns the TV on and starts the race. -->
        <receiver
            android:name=".Tidy$Receiver"
            android:exported="false" />

        <receiver
            android:name=".HomeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
