<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext stays off. The one exception is 127.0.0.1, this TV itself: MusicActivity's relay (ADR 0027), which
     passes the music screen's requests on to the music server over its own home-network-only socket. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
